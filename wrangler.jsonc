{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "balochai",
  "main": "_worker.js",
  "compatibility_date": "2026-08-13",

  "ai": {
    "binding": "AI"
  },

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "observability": {
    "enabled": true
  }
}
